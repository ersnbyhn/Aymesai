<html>
<head>
<title>Maaş Hesaplama - ErsNByhN</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<hta:application id="oMaas" applicationname="MaasHesap" border="thin" scroll="no" caption="yes" showintaskbar="yes" singleinstance="yes" sysmenu="yes" windowstate="normal">
<style>
    body { font-family: 'Segoe UI', Tahoma, Arial; background-color: #f0f2f5; margin: 0; padding: 3px; overflow: hidden; }
    .container { background: #ffffff; padding: 8px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); width: 440px; margin: auto; border-top: 5px solid #0057b8; }
    h2 { color: #0057b8; text-align: center; font-size: 13px; margin: 2px 0 5px 0; text-transform: uppercase; border-bottom: 1px solid #eee; padding-bottom: 3px; }
    table { width: 100%; border-collapse: collapse; }
    td { padding: 1px 3px; vertical-align: middle; }
    .lbl { font-weight: bold; font-size: 11px; width: 55%; color: #2c3e50; }
    .input-cell { width: 45%; }
    input, select { width: 100%; padding: 1px 3px; font-size: 11px; border: 1px solid #bdc3c7; border-radius: 4px; text-align: right; font-weight: bold; height: 20px; }
    .readonly-input { background-color: #f1f2f6; color: #d35400; border-color: #bdc3c7; }
    .editable-param { background-color: #fff9e6; color: #27ae60; border: 1px solid #27ae60; }
    .btn { width: 100%; padding: 6px; margin-top: 6px; background-color: #0057b8; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: bold; }
    .btn:hover { background-color: #004494; }
    .result-panel { margin-top: 8px; padding: 5px; background-color: #fff9f4; border: 1px dashed #d35400; border-radius: 6px; }
    .result-row { display: flex; justify-content: space-between; font-size: 12px; font-weight: bold; color: #2c3e50; margin: 2px 0; }
    .result-val { color: #d35400; }
    .footer { text-align: right; margin-top: 4px; font-size: 10px; font-weight: bold; color: #7f8c8d; border-top: 1px solid #eee; padding-top: 2px; }
    hr { margin: 4px 0; border: 0; border-top: 1px solid #eee; }
    
    /* Gece Zammı Özel Düzenleme */
    .gz-label-area { display: flex; align-items: center; justify-content: space-between; padding-right: 5px; }
    .gz-small-box { width: 45px !important; height: 18px !important; font-size: 10px !important; margin-left: 5px; }
</style>

<script language="VBScript">
    Sub Window_OnLoad
        window.resizeTo 470, 880
        document.getElementById("s9").value = "310,02" 
        document.getElementById("s10").value = "3341,82"
        document.getElementById("s12").value = "1121,24"
        document.getElementById("s12d").value = "1112,73"
        document.getElementById("gz_oran").value = "30,63"
        document.getElementById("asgari").value = "33030,00"
        document.getElementById("dv_muaf").value = "250,70"
        document.getElementById("gv_muaf").value = "4211,33"
    End Sub

    Function G(id)
        Dim val
        val = document.getElementById(id).value
        If val = "" Then G = 0 Else val = Replace(val, ".", ",") : If IsNumeric(val) Then G = CDbl(val) Else G = 0
    End Function

    Sub OtomatikHesapla
        B2 = G("s1") : B3 = G("s2")
        document.getElementById("s3").value = FormatNumber(B2 * B3, 2, -1, 0, 0)
        document.getElementById("s11").value = FormatNumber(75 * B2, 2, -1, 0, 0)
    End Sub

    Sub HandleEnter()
        If window.event.keyCode = 13 Then
            window.event.returnValue = False
            Dim cId, nId
            cId = window.event.srcElement.id
            Select Case cId
                Case "s1": nId = "s2"
                Case "s2": nId = "s4"
                Case "s4": nId = "s5"
                Case "s5": nId = "s6"
                Case "s6": nId = "s7"
                Case "s7": nId = "s8"
                Case "s8": nId = "s13"
                Case "s13": nId = "s14"
                Case "s14": nId = "s9"
                Case "s9": nId = "s10"
                Case "s10": nId = "s12"
                Case "s12": nId = "s12d"
                Case "s12d": nId = "asgari"
                Case "asgari": nId = "dv_muaf"
                Case "dv_muaf": nId = "gv_muaf"
                Case "gv_muaf": nId = "s16"
                Case "s16": nId = "s17"
                Case "s17": nId = "s18"
                Case "s18": nId = "s19"
                Case "s19": nId = "s20"
                Case "s20": nId = "v1"
                Case "v1": Hesapla : Exit Sub
            End Select
            On Error Resume Next
            document.getElementById(nId).Focus
        End If
    End Sub

    Sub Hesapla
        On Error Resume Next
        B2 = G("s1") : B3 = G("s2") : B4 = B2 * B3
        C5 = G("s4") * B2 * 2 : C6 = G("s5") * B2 * 2 : C7 = G("s6") * B2 * 2.25 
        C8 = G("s7") * G("gz_oran") : C9 = G("s8")
        B10 = G("s9") : B11 = 75 * B2 : B12 = G("s10") : B13 = G("s12") 
        B16 = 0 : B16_2 = G("s16") : B17 = G("s17") : B18 = G("s18") : B20 = G("s19") : B22 = G("s20")
        
        DV_M = G("dv_muaf") : GV_M = G("gv_muaf")

        B26 = B4 + C5 + C6 + C7 + C8 + C9 + B10 + B11 + B12 + B13 + B16 + B16_2 + B17 + B18 + B20 + B22
        B27 = B26 - B10 - B13 - B16 
        
        B30 = Round(B27 * 0.14, 2) : B31 = Round(B27 * 0.01, 2) : B15 = G("s14") 
        B29 = B27 - B30 - B31 - B15
        
        v_oran = CDbl(document.getElementById("v1").value) / 100
        B33 = Round((B29 * v_oran) - GV_M, 2) : If B33 < 0 Then B33 = 0
        B32 = Round((B26 * 0.00759) - DV_M, 2) : If B32 < 0 Then B32 = 0
        
        B40 = B30 + B31 + B32 + B33 : B14 = G("s13") : D13 = G("s12d") : B23 = 0
        B41 = B15 + B14 + B23 + D13 
        
        B42 = B26 - B41 - B40 : B43 = B42 + B14       
        
        document.getElementById("res6").innerHTML = FormatCurrency(B42, 2)
        document.getElementById("resToplam").innerHTML = FormatCurrency(B43, 2)
        MsgBox "Hesaplama Tamamlandı!", 64, "ErsNByhN"
    End Sub
</script>
</head>
<body onkeydown="HandleEnter()">
<div class="container">
    <h2>Maaş Hesaplama Otomasyonu</h2>
    <table>
        <tr><td class="lbl">Saat Ücreti:</td><td class="input-cell"><input type="text" id="s1" onkeyup="OtomatikHesapla"></td></tr>
        <tr><td class="lbl">Çalışma Saati:</td><td class="input-cell"><input type="text" id="s2" onkeyup="OtomatikHesapla"></td></tr>
        <tr><td class="lbl">Temel Brüt :</td><td class="input-cell"><input type="text" id="s3" class="readonly-input" readonly></td></tr>
        <tr><td class="lbl">İkramiye :</td><td class="input-cell"><input type="text" id="s11" class="readonly-input" readonly></td></tr>
        <tr><td colspan="2"><hr></td></tr>
        <tr><td class="lbl">Mesai Saati (x2):</td><td class="input-cell"><input type="text" id="s4"></td></tr>
        <tr><td class="lbl">Vardiya Dön. Saati (x2):</td><td class="input-cell"><input type="text" id="s5"></td></tr>
        <tr><td class="lbl">Bayram Mesai Saati (x2.25):</td><td class="input-cell"><input type="text" id="s6"></td></tr>
        <tr>
            <td class="lbl">
                <div class="gz-label-area">
                    <span>Gece Zammı Saati (x30.63):</span>
                    <input type="text" id="gz_oran" class="editable-param gz-small-box">
                </div>
            </td>
            <td class="input-cell"><input type="text" id="s7"></td>
        </tr>
        <tr><td class="lbl">FM Gece Zammı (TL):</td><td class="input-cell"><input type="text" id="s8"></td></tr>
        <tr><td class="lbl">Avans :</td><td class="input-cell"><input type="text" id="s13"></td></tr>
        <tr><td class="lbl">Sendika Aidatı :</td><td class="input-cell"><input type="text" id="s14"></td></tr>
        <tr><td colspan="2"><hr></td></tr>
        <tr><td class="lbl">Çocuk Yardımı:</td><td class="input-cell"><input type="text" id="s9"></td></tr>
        <tr><td class="lbl">Yakacak Yardımı:</td><td class="input-cell"><input type="text" id="s10"></td></tr>
        <tr><td class="lbl">Sağlık Sigortası :</td><td class="input-cell"><input type="text" id="s12"></td></tr>
        <tr><td class="lbl">Sağlık Sigortası (Özel):</td><td class="input-cell"><input type="text" id="s12d"></td></tr>
        <tr><td class="lbl">Asgari Ücret BRÜT:</td><td class="input-cell"><input type="text" id="asgari" class="editable-param"></td></tr>
        <tr><td class="lbl">DV Muafiyeti:</td><td class="input-cell"><input type="text" id="dv_muaf" class="editable-param"></td></tr>
        <tr><td class="lbl">GV Muafiyeti:</td><td class="input-cell"><input type="text" id="gv_muaf" class="editable-param"></td></tr>
        <tr><td colspan="2"><hr></td></tr>
        <tr><td class="lbl">Ayni Yardım 2:</td><td class="input-cell"><input type="text" id="s16"></td></tr>
        <tr><td class="lbl">İzin Parası:</td><td class="input-cell"><input type="text" id="s17"></td></tr>
        <tr><td class="lbl">Alışveriş Çeki:</td><td class="input-cell"><input type="text" id="s18"></td></tr>
        <tr><td class="lbl">Bayram Ücreti:</td><td class="input-cell"><input type="text" id="s19"></td></tr>
        <tr><td class="lbl">Öğrenim Yardımı:</td><td class="input-cell"><input type="text" id="s20"></td></tr>
        <tr><td class="lbl">Vergi Dilimi:</td><td class="input-cell">
            <select id="v1">
                <option value="15">%15</option>
                <option value="20" selected>%20</option>
                <option value="27">%27</option>
            </select>
        </td></tr>
    </table>
    <button class="btn" onclick="Hesapla" id="btnHesapla">MAAŞI HESAPLA</button>
    <div class="result-panel">
        <div class="result-row"><span>TOPLAM MAAŞ (Net):</span><span id="res6" class="result-val">0,00 TL</span></div>
        <div class="result-row"><span>AYIN 6'SI NET ÖDEME:</span><span id="resToplam" class="result-val">0,00 TL</span></div>
    </div>
    <div class="footer">Hazırlayan: <span>ErsNByhN</span></div>
</div>
</body>
</html>
